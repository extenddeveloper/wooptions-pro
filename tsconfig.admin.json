{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "outFile": "build/admin.js",
    "jsx": "react",
    "jsxFactory": "wp.element.createElement",
    "jsxFragmentFactory": "wp.element.Fragment",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "removeComments": false,
    "newLine": "lf"
  },
  "files": [
    "resources/admin/types/globals.d.ts",
    "resources/admin/types/models.ts",
    "resources/admin/core/utils.ts",
    "resources/admin/core/api.ts",
    "resources/admin/store/builder-store.ts",
    "resources/admin/builder/field-factory.ts",
    "resources/admin/components/icons.tsx",
    "resources/admin/components/common.tsx",
    "resources/admin/components/toast.tsx",
    "resources/admin/components/license-modal.tsx",
    "resources/admin/components/shell.tsx",
    "resources/admin/pages/dashboard.tsx",
    "resources/admin/pages/option-sets.tsx",
    "resources/admin/pages/templates.tsx",
    "resources/admin/pages/analytics.tsx",
    "resources/admin/pages/system-pages.tsx",
    "resources/admin/pages/license.tsx",
    "resources/admin/builder/field-preview.tsx",
    "resources/admin/builder/elements-panel.tsx",
    "resources/admin/builder/canvas.tsx",
    "resources/admin/builder/style-studio.tsx",
    "resources/admin/builder/logic-editor.tsx",
    "resources/admin/builder/inspector.tsx",
    "resources/admin/builder/history-modal.tsx",
    "resources/admin/builder/assignments-modal.tsx",
    "resources/admin/builder/builder.tsx",
    "resources/admin/app.tsx",
    "resources/admin/index.tsx"
  ]
}
