{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wooptions-pro/product-options",
  "version": "1.0.0",
  "title": "WooOptions Pro Product Options",
  "category": "woocommerce",
  "icon": "screenoptions",
  "description": "Displays the effective product options for the current WooCommerce product.",
  "textdomain": "wooptions-pro",
  "attributes": {
    "productId": {
      "type": "integer",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  }
}
